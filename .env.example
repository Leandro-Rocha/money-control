# Senha mestra de acesso à aplicação
APP_PASSWORD=sua-senha-segura-aqui

# Segredo para assinatura criptográfica dos cookies de sessão (HMAC-SHA256)
AUTH_SECRET=gere-uma-chave-secreta-longa-e-aleatoria-aqui

# PIN numérico para ocultar/desocultar valores na interface (modo privacidade)
APP_PIN=1234

# Repositório Git remoto privado e isolado para backup automático diário (opcional)
# Se não configurado, o backup é salvo localmente em data/backups/
# BACKUP_GIT_REMOTE=https://oauth2:SEU_GITHUB_TOKEN@github.com/seu-usuario/money-control-backup.git

