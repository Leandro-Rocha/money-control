# Senha mestra de acesso à aplicação
APP_PASSWORD=sua-senha-segura-aqui

# Segredo para assinatura criptográfica dos cookies de sessão (HMAC-SHA256)
AUTH_SECRET=gere-uma-chave-secreta-longa-e-aleatoria-aqui

# PIN numérico para ocultar/desocultar valores na interface (modo privacidade)
APP_PIN=1234

# Repositório Git remoto privado e isolado para backup automático diário (opcional)
# Se não configurado, o backup é salvo localmente em data/backups/
# BACKUP_GIT_REMOTE=https://oauth2:SEU_GITHUB_TOKEN@github.com/seu-usuario/money-control-backup.git

# Integração Pluggy Open Finance - Credencial Principal (opcional)
# PLUGGY_CLIENT_ID=seu-client-id-aqui
# PLUGGY_CLIENT_SECRET=seu-client-secret-aqui
# PLUGGY_CREDENTIAL_LABEL="Pluggy Principal"

# Integração Pluggy Open Finance - Credenciais Adicionais (opcional, para múltiplas contas de desenvolvedor)
# Suporta sufixos numéricos (_2, _3, ...) para contornar limites de conexões gratuitas:
# PLUGGY_CLIENT_ID_2=seu-segundo-client-id-aqui
# PLUGGY_CLIENT_SECRET_2=seu-segundo-client-secret-aqui
# PLUGGY_CREDENTIAL_LABEL_2="Pluggy Secundário"

# Alternativa via JSON (opcional):
# PLUGGY_CREDENTIALS='[{"id":"secundario","clientId":"...","clientSecret":"...","label":"Pluggy Secundário"}]'

# Notificações Push via ntfy
NTFY_TOPIC=seu-topico-secreto-ntfy
NTFY_BASE_URL=https://ntfy.sh
APP_PUBLIC_URL=https://money.cafofo.casa
REMINDERS_API_SECRET=seu-token-secreto-para-acoes-http

